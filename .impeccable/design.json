      "css": ".ds-nav{width:208px;background:#fff;border-right:1px solid #aeb7c4;padding:10px 0}.ds-nav__p{display:flex;align-items:center;height:48px;padding:0 16px;font-size:.95rem;color:#5c6675;border-left:3px solid transparent;cursor:pointer}.ds-nav__p:hover{background:#e8eef7}.ds-nav__p.aktiv{color:#003884;font-weight:600;background:#e8eef7;border-left-color:#003884}"
    },
