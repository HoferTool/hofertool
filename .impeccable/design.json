  "components": [
    {
      "name": "Hauptknopf",
      "kind": "button",
      "refersTo": "knopf-haupt",
      "description": "Wichtigste Aktion in Formularen und Dialogen.",
      "html": "<button class=\"ds-knopf ds-knopf--haupt\">Speichern</button>",
      "css": ".ds-knopf{min-height:46px;padding:11px 18px;font:inherit;font-weight:600;color:var(--tinte,#1d2430);background:var(--flaeche,#fff);border:1px solid var(--linie-stark,#aeb7c4);border-radius:4px;cursor:pointer;transition:transform .12s,background .12s}.ds-knopf:active{transform:translateY(1px)}.ds-knopf:focus-visible{outline:3px solid #003884;outline-offset:1px}.ds-knopf--haupt{background:#003884;border-color:#003884;color:#fff}.ds-knopf--haupt:hover{background:#002b66}"
    },
    {
      "name": "Standardknopf",
      "kind": "button",
      "refersTo": "knopf",
      "description": "Neben- und Abbrechen-Aktionen.",
      "html": "<button class=\"ds-knopf2\">Abbrechen</button>",
      "css": ".ds-knopf2{min-height:46px;padding:11px 18px;font:inherit;font-weight:600;color:#1d2430;background:#fff;border:1px solid #aeb7c4;border-radius:4px;cursor:pointer}.ds-knopf2:hover{background:#e8eef7}.ds-knopf2:active{transform:translateY(1px)}.ds-knopf2:focus-visible{outline:3px solid #003884;outline-offset:1px}"
    },
    {
      "name": "Gefahrknopf",
      "kind": "button",
      "refersTo": "knopf-gefahr",
      "description": "Löschen und Entfernen.",
      "html": "<button class=\"ds-knopf-gefahr\">Löschen</button>",
      "css": ".ds-knopf-gefahr{min-height:46px;padding:11px 18px;font:inherit;font-weight:600;color:#fff;background:#b3261e;border:1px solid #b3261e;border-radius:4px;cursor:pointer}.ds-knopf-gefahr:hover{filter:brightness(.92)}.ds-knopf-gefahr:focus-visible{outline:3px solid #003884;outline-offset:1px}"
    },
    {
      "name": "Eingabefeld",
      "kind": "input",
      "refersTo": "eingabe",
      "description": "Feld mit Beschriftung darüber.",
      "html": "<label class=\"ds-feld\"><span>FA Nr.</span><input value=\"2026-0303\"></label>",
      "css": ".ds-feld{display:block}.ds-feld span{display:block;margin-bottom:5px;font-size:.85rem;font-weight:600;color:#5c6675}.ds-feld input{width:100%;min-height:46px;padding:10px 12px;font:inherit;font-variant-numeric:tabular-nums;color:#1d2430;background:#fff;border:1px solid #aeb7c4;border-radius:4px}.ds-feld input:focus-visible{outline:3px solid #003884;outline-offset:1px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
